{
  "name": "@dtfoundry/trustable-verify",
  "version": "0.1.0",
  "description": "Offline verifier for the Trustable portable verify package. Checks a credential's integrity, its issuer's authorship and its revocation state with no network access.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Digital-Trust-Foundry/trustable-verify.git"
  },
  "homepage": "https://github.com/Digital-Trust-Foundry/trustable-verify#readme",
  "bugs": "https://github.com/Digital-Trust-Foundry/trustable-verify/issues",
  "keywords": ["keri", "acdc", "cesr", "verifiable-credentials", "offline", "trustable"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": { "access": "public" }
}
